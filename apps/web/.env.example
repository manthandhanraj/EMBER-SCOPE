# Optional. Copy to .env.local and set one provider; do not commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local AI (installed models, no API key; hosted deployments need a remote provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b-instruct is Apache-2.0. Avoid qwen2.5:3b/72b: they use the non-OSI Qwen Research/Qwen licenses.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=all-minilm
# OLLAMA_DISABLED=1
